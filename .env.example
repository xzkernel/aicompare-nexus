# ModelWise self-host — copy to `.env` in repo root for docker compose -f docker-compose.prod.yml

# Your public frontend origin (required in production)
CORS_ORIGINS=https://modelwise.example.com

# Optional: server-side OpenRouter catalog hydration
# OPENROUTER_API_KEY=

# Backend runtime
ENVIRONMENT=production
ENABLE_API_DOCS=false

# Trust nginx / Docker proxy when reading X-Forwarded-For (default covers docker private ranges)
# TRUSTED_PROXY_IPS=127.0.0.1,::1,172.16.0.0/12

# Rate limits (optional)
# RATE_LIMIT_PER_MINUTE=60
# RATE_LIMIT_PER_HOUR=1000

# Vercel/Railway split deploy: set this in Vercel to your Railway backend origin.
# Leave empty for local Vite proxy or same-origin Docker/nginx deployments.
# VITE_API_URL=https://your-backend.up.railway.app

# Optional Supabase (frontend build args — see docs/SELF_HOSTING.md)
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
