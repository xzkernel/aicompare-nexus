{
  "name": "modelwise",
  "description": "Open-source AI model comparison platform with BYOK (Bring Your Own Key) support",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@10.9.3",
  "type": "module",
  "keywords": [
    "ai",
    "comparison",
    "openai",
    "google",
    "anthropic",
    "meta",
    "byok",
    "react",
    "typescript",
    "fastapi"
  ],
  "author": "ModelWise Team",
  "repository": {
    "type": "git",
    "url": "https://github.com/xzkernel/aicompare-nexus.git"
  },
  "homepage": "https://github.com/xzkernel/aicompare-nexus#readme",
  "bugs": {
    "url": "https://github.com/xzkernel/aicompare-nexus/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "audit:prod": "node scripts/audit-prod.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "screenshots": "node scripts/capture-screenshots.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-toast": "^1.2.14",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^26.3.1",
    "idb": "^8.0.3",
    "lucide-react": "^0.462.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.8",
    "react-markdown": "^10.1.0",
    "react-router-dom": "7.18.2",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-sanitize": "^6.0.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@types/node": "^22.16.5",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react-swc": "^4.3.2",
    "autoprefixer": "^10.4.21",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "fake-indexeddb": "^6.2.4",
    "globals": "^17.8.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.0.18"
